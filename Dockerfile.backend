# -----------------------------------------------------------------------------
# CloudSim DRL Scheduler: Backend API Gateway & Model Server
# -----------------------------------------------------------------------------
FROM python:3.10-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libzmq3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir fastapi uvicorn websockets pydantic requests

# Copy source code, models, and frontend
COPY python_agent/ python_agent/
COPY web_backend/ web_backend/
COPY web_dashboard/ web_dashboard/
COPY models/ models/

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["uvicorn", "web_backend.server:app", "--host", "0.0.0.0", "--port", "8000"]
